# Copy to .env before `docker compose up`. Never commit .env.

# Required. Compose refuses to start without it.
POSTGRES_PASSWORD=change-me

# Optional. Defaults are platform / platform.
# POSTGRES_DB=platform
# POSTGRES_USER=platform

# Host port for the web container (container listens on 8080).
# APP_PORT=4173

# Optional image overrides. Leave unset to build locally
# (platform-web:local and platform-api:local).
# WEB_IMAGE=
# API_IMAGE=
