# API Configuration
VITE_API_URL=/api

# Full-stack Docker Compose
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me
APP_PORT=4173
WEB_IMAGE=platform-web:local
API_IMAGE=platform-api:local

# Pipeline monitor (API-side; never expose the token to Vite)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Base URL the API probes for staging smoke checks
STAGING_URL=http://localhost:4173

# Optional: Analytics
VITE_ANALYTICS_ID=

# Optional: Sentry DSN
VITE_SENTRY_DSN=
